#!/bin/sh
# Foundry guard: no direct pushes to the default branch — work lands via PR
# (/foundry:open-pr → /foundry:merge-pr). Enable with:
#   git config core.hooksPath .githooks
hook_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 1
exec python3 "$hook_dir/../hooks/privacy_pre_push.py" "$@"
